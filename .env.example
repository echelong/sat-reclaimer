# Copy to .env.local. Both flags default to off when unset.
#
# Mainnet stays locked until the M1 signer proof passes on Signet/Testnet and a
# manual decision is made to unlock it.
NEXT_PUBLIC_ENABLE_MAINNET=false
#
# Broadcasting is a separate, explicitly gated step. Signet/Testnet only; the
# Mainnet broadcast path is refused in code regardless of this flag.
NEXT_PUBLIC_ENABLE_SIGNET_BROADCAST=false
