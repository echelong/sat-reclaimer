# Copy to .env.local. Every flag defaults to off when unset: only the exact
# string "true" enables a flag.
#
# Mainnet is disabled by default. Setting this to exactly "true" is an explicit
# operator decision that enables the Sweep All workflow on Mainnet: the whole
# wallet is retrieved, the largest safe transaction is planned from its measured
# size, the full pre-sign disclosure is shown, every signed PSBT is independently
# verified, and broadcast is a separate explicit step. If Xverse rejects a large
# payload the app re-plans the same wallet into the minimum number of batches.
NEXT_PUBLIC_ENABLE_MAINNET=false
#
# Broadcasting is a separate, explicitly authorized manual step.
#
# Signet/Testnet broadcasting:
NEXT_PUBLIC_ENABLE_SIGNET_BROADCAST=false
#
# Mainnet broadcasting requires BOTH NEXT_PUBLIC_ENABLE_MAINNET and this flag.
# The Signet/Testnet flag can never unlock Mainnet. While this flag is unset the
# app can build, sign and independently verify a Mainnet sweep, but the
# "Broadcast Mainnet Transaction" button is disabled and the broadcast layer
# refuses in code, regardless of UI state.
NEXT_PUBLIC_ENABLE_MAINNET_BROADCAST=false
