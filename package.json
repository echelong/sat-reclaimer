    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sats-connect": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
