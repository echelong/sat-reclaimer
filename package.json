{
  "name": "sat-reclaimer",
  "version": "0.1.0-rc.2",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "local": "node scripts/start-local.mjs",
    "local:check": "node scripts/check-environment.mjs",
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:max": "LARGE_WALLET_MAX=1 vitest run tests/large-wallet.test.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sats-connect": "4.2.1"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0",
      "valibot": "^1.5.0"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
